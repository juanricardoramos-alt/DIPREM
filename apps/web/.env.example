# ============================================================================
# DIPREM CRM — Web (Next.js) sobre Neon Auth + Neon Data API
# Copiar a .env.local y reemplazar con los valores reales de tu proyecto Neon
# (rama dev). NUNCA subir .env.local al repo.
# ============================================================================

# --- Neon Auth (servidor; NO exponer con NEXT_PUBLIC) ---
# URL del Auth server (consola Neon → rama dev → Auth)
NEON_AUTH_BASE_URL=https://REEMPLAZAR.neonauth.tld
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres).
# Generar con:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=REEMPLAZAR_CON_32_CHARS_O_MAS

# --- Expuestas al navegador ---
# La misma URL del Auth server, para el cliente del navegador
NEXT_PUBLIC_NEON_AUTH_BASE_URL=https://REEMPLAZAR.neonauth.tld
# Endpoint REST de la Neon Data API (consola Neon → rama dev → Data API)
NEXT_PUBLIC_DATA_API_URL=https://REEMPLAZAR-data-api.neon.tld/rest/v1

# NOTA: DATABASE_URL NO va aquí. Es solo para migraciones/scripts (bypasea
# RLS) y vive fuera del repo, en el entorno de quien corre `pnpm db:migrate`.
